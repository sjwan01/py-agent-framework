LLM_MODEL_ID=qwen3.5-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-api-key

# Thinking (main agent).  Maps to pydantic-ai ModelSettings.thinking.
# THINKING_ENABLED=true
# THINKING_LEVEL=

# Session persistence: set POSTGRES_URL to use Postgres, otherwise SQLite.
# POSTGRES_URL=postgresql://user:pass@localhost:5432/db
# PG_POOL_SIZE=5
# PG_MAX_OVERFLOW=10

# SQLite path; leave unset to use an ephemeral temp DB.
# SQLITE_PATH=sessions.db

# Stale session cleanup (seconds).
# SESSION_IDLE_TIMEOUT_SECONDS=86400

# Context management
# CONTEXT_WINDOW=128000
# LOW_WATERMARK_RATIO=0.6
# HIGH_WATERMARK_RATIO=0.75
# PROTECT_TURNS=5
# TRUNCATE_TOOL_RESULT_CHARS=1000

# Tool execution
# MAX_TOOL_CALLS_PER_TURN=5
# PARALLEL_TOOL_CALLS=false

# Compaction summarizer (OpenAI-compatible model). Leave unset to skip LLM summarization.
# COMPACTION_MODEL_ID=gpt-4o-mini
# COMPACTION_MAX_OUTPUT_TOKENS=300

# Compaction — independent base_url / api_key (falls back to main LLM if unset).
# COMPACTION_BASE_URL=
# COMPACTION_API_KEY=

# Compaction thinking (separate from main agent).
# COMPACTION_THINKING_ENABLED=false
# COMPACTION_THINKING_LEVEL=

# Custom compaction summary prompt.  Uses built-in four-section template if unset.
# COMPACTION_SUMMARY_PROMPT=
